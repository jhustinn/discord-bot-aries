# ==============================================================================
# DISCORD BOT ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your real values.
# ==============================================================================

# Discord Bot Token (from Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Guild / Server ID (Required for instant slash command registration)
GUILD_ID=your_guild_id_here

# Channel ID where the verification panel / button will be posted
WELCOME_CHANNEL_ID=your_welcome_channel_id_here

# Category ID where active verification tickets will be created
TICKET_CATEGORY_ID=your_ticket_category_id_here

# Category ID where closed tickets will be archived/locked
CLOSED_CATEGORY_ID=your_closed_category_id_here

# Default Role ID given to verified players (from Discord Server Settings > Roles)
VERIFIED_ROLE_ID=your_verified_role_id_here

# Keep-alive & internal REST API port (default: 3000)
PORT=3000

# API Secret Key for securing bot REST API endpoints (shared with Laravel backend)
API_SECRET_KEY=aries-admin-2024

# Laravel API Base URL
MW_API_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# OCR (Optical Character Recognition) Engine Selection
# ------------------------------------------------------------------------------
# 1. Google Gemini 1.5 Flash Vision (Recommended: High accuracy for Unicode symbols)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Cloud Vision API Credentials (Optional fallback)
# Single-line JSON string from Google Cloud Console Service Account Key
GOOGLE_CREDENTIALS=

# 3. OCR.space API Key (Optional basic fallback, default: helloworld)
OCR_API_KEY=helloworld

# ------------------------------------------------------------------------------
# Database Storage (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here
